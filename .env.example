# Public site origin. Used for canonical URLs, Open Graph, sitemap and structured data.
# Example production value: https://your-domain.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional. Leave empty to hide every GitHub link in the UI.
# Example: https://github.com/your-username
NEXT_PUBLIC_GITHUB_URL=

# Optional. Free Web3Forms access key (https://web3forms.com) — no credit card.
# If unset, the form uses FormSubmit (also free). First FormSubmit send needs inbox confirmation.
NEXT_PUBLIC_WEB3FORMS_ACCESS_KEY=

# Resend — only used if you later host on Vercel and keep /api/contact.
RESEND_API_KEY=

# Must be a sender Resend has verified (domain or their onboarding address).
# Example: Portfolio <hello@your-domain.com>
CONTACT_FROM_EMAIL=

# Where contact form submissions should be delivered.
CONTACT_TO_EMAIL=razasaeed135@gmail.com
